{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "phpUnit": {
        "configDir": "."
    },
    "testFramework": "testo",
    // ~98.7% is the honest ceiling. Both survivors are equivalent mutants:
    //   - `(string) $name` cast on already-string header keys (redundant);
    //   - `InMemoryIdempotencyStorage` `$claims[$key] = true` — only `isset()` is
    //     read, so the stored value is irrelevant.
    "minMsi": 98,
    "mutators": {
        "@default": true
    }
}
